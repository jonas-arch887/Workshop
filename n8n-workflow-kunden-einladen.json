{
  "name": "FrachtHub Workshop — Kunden einladen",
  "nodes": [
    {
      "parameters": {
        "formTitle": "FrachtHub — Workshop Kunde einladen",
        "formDescription": "Neuen Kunden zum Analyse-Workshop einladen. Der Kunde erhält automatisch eine personalisierte Einladungs-E-Mail.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "fieldType": "text",
              "placeholder": "z.B. Thomas Müller",
              "requiredField": true
            },
            {
              "fieldLabel": "E-Mail",
              "fieldType": "email",
              "placeholder": "z.B. thomas@spedition.de",
              "requiredField": true
            },
            {
              "fieldLabel": "Firma",
              "fieldType": "text",
              "placeholder": "z.B. Spedition Müller GmbH",
              "requiredField": true
            },
            {
              "fieldLabel": "Workshop-Datum",
              "fieldType": "date",
              "requiredField": false
            }
          ]
        },
        "responseMode": "onReceived",
        "responseText": "✅ Einladung wurde versendet! Der Kunde erhält in Kürze eine E-Mail mit seinem persönlichen Zugangslink.",
        "options": {}
      },
      "id": "form-trigger",
      "name": "Formular",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "frachthub-workshop-invite"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bspsckyzjdrytlpxpdjr.supabase.co/functions/v1/invite-user",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $json['E-Mail'] }}"
            },
            {
              "name": "name",
              "value": "={{ $json['Name'] }}"
            },
            {
              "name": "firma",
              "value": "={{ $json['Firma'] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "supabase-invite",
      "name": "Supabase: User einladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Formular": {
      "main": [
        [
          {
            "node": "Supabase: User einladen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "frachthub-workshop"
  },
  "tags": []
}
